{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动企业微信 ChatGpt 群机器人",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.cli",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml",
        "start"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "检查企业微信机器人与 ChatGPT Plus",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.cli",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml",
        "doctor",
        "--connect"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "登录 ChatGPT Plus（首次运行）",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.cli",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml",
        "chatgpt-login"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
