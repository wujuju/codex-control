{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "首次登录 ChatGPT Plus",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.cli",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml",
        "chatgpt-login"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "启动微信助手（GUI）",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.gui",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "启动微信助手（命令行）",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.cli",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml",
        "start"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "检查运行环境（Doctor）",
      "type": "debugpy",
      "request": "launch",
      "module": "wechat_codex.cli",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}\\config.yaml",
        "doctor",
        "--connect"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
