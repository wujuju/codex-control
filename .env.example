# GitHub control repository. Public repo is supported, but comments/results are public.
GITHUB_REPO=wujuju/codex-control

# If empty or 0, bridge will find or create an open issue with GITHUB_CONTROL_ISSUE_TITLE.
GITHUB_ISSUE_NUMBER=0
GITHUB_CONTROL_ISSUE_TITLE=Codex Control Console

# Token used to read/post issue comments.
# Classic PAT: public_repo is enough for a public repo.
# Fine-grained PAT: repository Issues read/write permission.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only these GitHub usernames can trigger commands. Comma-separated.
# IMPORTANT for public repositories. If empty, bridge will allow only the token owner's login.
GITHUB_ALLOWED_USERS=

# Ignore comments generated by these users. Comma-separated. Optional.
GITHUB_IGNORE_USERS=

# Poll interval in seconds. Keep >= 10 to avoid wasting rate limit.
POLL_INTERVAL_SECONDS=15

# On first start, skip old comments to avoid executing history.
# Set true only when you intentionally want to replay old commands.
CATCH_UP_ON_START=false

# Optional command prefix. Examples: ! or / or codex:
# If empty, commands like 状态 / 继续 xxx work directly.
COMMAND_PREFIX=

# Your local coding repository. Codex runs here, not inside codex-control.
REPO_PATH=D:\Sam\HGameAI
CODEX_BIN=codex

# Extra args appended to codex exec command, e.g. --full-auto or --sandbox workspace-write
# Safer default is empty. Do not enable --yolo unless you know what you are doing.
CODEX_EXTRA_ARGS=

# Max seconds for one Codex run. 0 means no timeout.
CODEX_TIMEOUT_SECONDS=0

# Local test command. Triggered by GitHub comment: 测试
# This is local config, not accepted from GitHub comments.
TEST_COMMAND=python -m pytest -q
TEST_TIMEOUT_SECONDS=1200

# State/log paths. Relative paths are under this bridge directory.
STATE_PATH=.codex_github_bridge/state.json
LOG_DIR=.codex_github_bridge/logs

# If true, bridge posts a startup comment each time it starts.
ANNOUNCE_ON_START=false
